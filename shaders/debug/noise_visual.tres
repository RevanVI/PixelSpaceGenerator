						(43758.5453123));
	}


// FloatOp:20
	float n_out20p0 = n_out2p0 - n_out7p0;


// FloatOp:21
	float n_out21p0 = n_out20p0 * n_out16p0;


// FloatOp:22
	float n_out22p0 = n_out21p0 * n_out16p1;


// FloatOp:23
	float n_out23p0 = n_out14p0 + n_out22p0;


// Output:0
	COLOR.rgb = vec3(n_out23p0);


}
