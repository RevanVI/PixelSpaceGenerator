						(43758.5453123));
	}


// FloatOp:15
	float n_out15p0 = n_out6p0 - n_out8p0;


// FloatOp:17
	float n_out17p0 = n_out15p0 * n_out16p1;


// FloatOp:18
	float n_in18p0 = 1.00000;
	float n_out18p0 = n_in18p0 - n_out16p0;


// FloatOp:19
	float n_out19p0 = n_out17p0 * n_out18p0;


// FloatOp:14
	float n_out14p0 = n_out13p0 + n_out19p0;


// VectorOp:11
	vec2 n_in11p1 = vec2(1.00000, 1.00000);
	vec2 n_out11p0 = n_out27p0 + n_in11p1;


