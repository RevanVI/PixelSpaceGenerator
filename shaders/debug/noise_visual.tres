[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_ra6op"]
size = Vector2(1580.0001, 839.99994)
expression = "vec2 i = floor(coord);
	vec2 f = fract(coord);

	float a = rand(i, seed);
	float b = rand(i + vec2(1.0, 0.0));
	float c = rand(i + vec2(0.0, 1.0));
	float d = rand(i + vec2(1.0, 1.0));

	vec2 cubic = f * f * (3.0 - 2.0 * f);

	return mix(a, b, cubic.x) +
            (c - a) * cubic.y * (1.0 - cubic.x) +
            (d - b) * cubic.x * cubic.y;"

